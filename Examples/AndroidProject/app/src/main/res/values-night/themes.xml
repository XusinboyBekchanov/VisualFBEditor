<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Standard text of the MyFbFramework controls (mff_styles.xml). -->
        <item name="android:textViewStyle">@style/MffTextView</item>
        <item name="android:editTextStyle">@style/MffEditText</item>
        <item name="checkboxStyle">@style/MffCheckBox</item>
        <item name="radioButtonStyle">@style/MffRadioButton</item>
        <item name="materialButtonStyle">@style/MffButton</item>
        <item name="android:calendarViewStyle">@style/MffCalendarView</item>
        <!-- Customize your theme here. -->
    </style>
</resources>