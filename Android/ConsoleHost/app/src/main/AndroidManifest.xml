<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.visualfbeditor.console">

    <!-- extractNativeLibs: libconsole-app.so (the program) is a file of nativeLibraryDir which can be run -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="FreeBASIC Console"
        android:theme="@android:style/Theme.DeviceDefault.Light">
        <activity android:name=".mffActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
