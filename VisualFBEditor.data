Namespace My.Sys.Forms
	#define QComboBoxEx(__Ptr__) (*Cast(ComboBoxEx Ptr, __Ptr__))
	#define QComboBoxItem(__Ptr__) (*Cast(ComboBoxItem Ptr,__Ptr__))
	
