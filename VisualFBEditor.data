tt></td><td><tt>&nbsp;B</tt></td><td><tt>2</tt></td><td><tt>--------</tt></=
td></tr>
<tr><td><tt>MOV&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;DH,ib</tt></td><td><tt>B6 i0</=
tt></td><td><tt>&nbsp;B</tt></td><td><tt>2</tt></td><td><tt>--------</tt></=
td></tr>
<tr><td><tt>MOV&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;DX,iw</tt></td><td><tt>BA i0 i=
1</tt></td><td><tt>&nbsp;W</tt></td><td><tt>3</tt></td><td><tt>--------</tt=
></td></tr>
