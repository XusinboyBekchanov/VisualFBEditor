Namespace My.Sys.Forms
	#define QGrid(__Ptr__) (*Cast(Grid Ptr, __Ptr__))
	#define QGridRow(__Ptr__) (*Cast(GridRow Ptr, __Ptr__))
	#define QGridCell(__Ptr__) (*Cast(GridCell Ptr, __Ptr__))
