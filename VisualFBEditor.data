<tr><td><tt>SETS&nbsp;&nbsp;&nbsp;&nbsp;rmb&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&n=
bsp;&nbsp;&nbsp;&nbsp;[386]</tt></td><td><tt>0F 98 mr d0 d1</tt></td><td>&n=
bsp;</td><td><tt>3~5</tt></td><td><tt>--------</tt></td></tr>
</tbody>
</table>
<div>
<dl>
<dt>Usage</dt><dd><tt>SETS&nbsp;&nbsp;&nbsp;&nbsp;dest</tt></dd>
