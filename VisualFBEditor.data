#include once "Dialogs.bi"
#include once "Printer.bi"
#if defined(__USE_WASM__) OrElse defined(__USE_JNI__)
	'Web and Android: the form of Page Setup (PageSetupDialog.Execute)
	#include once "Form.bi"
