	Private Property ToolBar.Transparency(Value As Boolean)
		FTransparent = Value
		#ifdef __USE_WINAPI__
			ChangeStyle TBSTYLE_TRANSPARENT, Value
		#endif
	End Property
	
	Private Property ToolBar.BitmapWidth As Integer
