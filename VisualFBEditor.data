	#ifndef ImageList_Remove_Integer_Off
		Private Sub ImageList.Remove(Index As Integer)
			#ifdef __USE_WINAPI__
				FNotChange = True
				Items.Remove Index
				FNotChange = False
				ImageList_Remove(Handle, Index)
			#endif
		End Sub
	#endif
	
	Private Sub ImageList.Remove(ByRef Key As WString)
		Remove(IndexOf(Key))
	End Sub
	
