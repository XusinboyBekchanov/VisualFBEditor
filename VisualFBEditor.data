			m_Border = True
			m_LabelsFormats = "{V}"
		Case CS_GroupedColumn To CS_StackedBarsPercent
			m_FillOpacity = 50
			m_Border = True
			m_LabelsFormats = "{V}"
		End Select
		Refresh
	End Property
	
