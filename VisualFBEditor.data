/td><td><tt>3~5</tt></td><td><tt>--------</tt></td></tr>
</tbody>
</table>
<div>
<dl>
<dt>Usage</dt><dd><tt>LFS&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;dest,src</tt></dd>
