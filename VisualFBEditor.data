		#ifdef __USE_WINAPI__
			ChangeStyle CCS_NODIVIDER, Not Value
		#endif
	End Property
	
	Private Property ToolBar.Transparency As Boolean
		#ifdef __USE_WINAPI__
			FTransparent = StyleExists(TBSTYLE_TRANSPARENT)
		#endif
		Return FTransparent
