	'			n = n + 1
	'			If (n >= items + 1 ) Then
	'				items += 50
	'				ReDim Preserve Result(0 To items - 1)
	'			End If
	'			Result(n - 1) = Mid(wszMainStr, p, i - p)
	'		End If
	'		p = i + tLen
	'		i = p
	'		Continue Do
