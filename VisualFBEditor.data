#include once "Object.bi"
#include once "Graphics.bi"
#ifdef __USE_WINAPI__
	#ifdef __FB_64BIT__
		#inclib "gdiplus"
		#include once "win/gdiplus-c.bi"
	#else
		#include once "win/ddraw.bi"
		#include once "win/gdiplus.bi"
		Using Gdiplus
	#endif
#elseif defined(__USE_GTK__)
