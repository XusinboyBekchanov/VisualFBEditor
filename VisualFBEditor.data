			Handle      As GtkIconTheme Ptr
		#elseif defined(__USE_JNI__)
			Handle      As jobject
		#elseif defined(__USE_WINAPI__)
			Handle      As HIMAGELIST
		#else
			Handle      As Any Ptr
		#endif
		InitialCount    As Integer
		GrowCount       As Integer
		ImageType       As ImageTypes
		DrawingStyle    As DrawingStyles
