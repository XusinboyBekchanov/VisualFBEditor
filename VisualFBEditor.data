#include once "Control.bi"
#ifdef GIFPlayOn
	#ifdef __FB_64BIT__
		#inclib "gdiplus"
		#include "win/gdiplus-c.bi"
	#else
		#include "win/gdiplus.bi"
		Using Gdiplus
	#endif
#endif
