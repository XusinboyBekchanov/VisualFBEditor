<tr><td><tt>LIDT&nbsp;&nbsp;&nbsp;&nbsp;mw&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nb=
sp;&nbsp;&nbsp;&nbsp;&nbsp;[286]</tt></td><td><tt>0F 01 /3 d0 d1</tt></td><=
td>&nbsp;</td><td><tt>3~5</tt></td><td><tt>--------</tt></td></tr>
</tbody>
</table>
<div>
<dl>
<dt>Usage</dt><dd><tt>LIDT&nbsp;&nbsp;&nbsp;&nbsp;src</tt></dd>
