				Dim IMIF As ImageInfo
				'BMP = CAllocate_(SizeOf(My.Sys.Drawing.BitmapType))
				ImageList_GetImageInfo(Handle,Index,@IMIF)
				Return IMIF.hbmImage 'BMP->Handle =
			#else
				Return FBMP
			#endif
			'Return *BMP
		End Function
	#endif
	
