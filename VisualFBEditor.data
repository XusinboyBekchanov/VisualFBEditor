	Declare Sub CanvasRotate(Id As Any Ptr, ByVal x As Double, ByVal y As Double, ByVal Angle As Double)
	Declare Sub CanvasSave(Id As Any Ptr)
	Declare Sub CanvasRestore(Id As Any Ptr)
