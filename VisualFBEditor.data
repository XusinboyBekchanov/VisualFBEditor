td></tr>
<tr><td><tt>MOV&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;CH,ib</tt></td><td><tt>B5 i0</=
tt></td><td><tt>&nbsp;B</tt></td><td><tt>2</tt></td><td><tt>--------</tt></=
td></tr>
<tr><td><tt>MOV&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;CX,iw</tt></td><td><tt>B9 i0 i=
