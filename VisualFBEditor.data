		#ifdef __USE_WINAPI__
			If Handle Then
				Var Size = Perform(TB_GETBUTTONSIZE, 0, 0)
				FButtonHeight = UnScaleY(HiWord(Size))
			End If
		#endif
		Return FButtonHeight
	End Property
	
	Private Property ToolBar.ButtonHeight(Value As Integer)
		FButtonHeight = Value
		#ifdef __USE_WINAPI__
